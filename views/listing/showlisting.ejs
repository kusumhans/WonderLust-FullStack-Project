<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>showlisting</title>
</head>
<body>
    <h2>Show all listing:</h2>
    <ul>
        <% for (let listing of allListing) { %>
    
            <li>
                <a href="/listing/<%= listing.id%>">
                    <%= listing.title %>
                 </a>
            </li>
    
        <% } %>
    </ul>
</body>
</html>